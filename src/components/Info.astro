---
import { getInfo } from '../lib/microcms';

const info = await getInfo();
---
<section id="info">
  <p class="eyebrow reveal">店舗情報・アクセス</p>
  <div class="info-grid">
    <table class="info-table reveal">
      <tr><th>店名</th><td>楽食ふじた</td></tr>
      <tr><th>住所</th><td>東京都目黒区中目黒2-0-16 ウィングビル1F</td></tr>
      <tr><th>アクセス</th><td>東急東横線・日比谷線「中目黒駅」より徒歩7分</td></tr>
      <tr><th>電話</th><td><a href="tel:0364512969">03-6451-2969</a></td></tr>
      <tr><th>営業時間</th><td set:html={info.hours.replace(/\n/g, '<br/>')} /></tr>
      {info.holiday && <tr><th>定休日</th><td>{info.holiday}</td></tr>}
      <tr><th>席数</th><td>カウンター・テーブル 約12席</td></tr>
      {info.note && <tr><th>備考</th><td set:html={info.note.replace(/\n/g, '<br/>')} /></tr>}
    </table>
    <div class="info-map reveal">
      <iframe 
        src="https://maps.google.co.jp/maps?q=楽食ふじた+中目黒&output=embed&t=m&z=17" 
        style="border:0;" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
    </div>
  </div>
</section>

<style>
/* ---------- 店舗情報 ---------- */
.info-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:56px}
.info-table{width:100%;border-collapse:collapse;font-size:14px}
.info-table th,.info-table td{
  text-align:left;vertical-align:top;
  padding:16px 0;border-bottom:1px solid var(--line);
  font-weight:400;letter-spacing:.1em;
}
.info-table th{width:8em;color:var(--mut);font-family:var(--sans);font-size:12px;letter-spacing:.25em}
.info-table td{color:var(--dim)}
.info-map{
  aspect-ratio:16/10;
  width:100%;
  background:var(--sumi2);
  border-radius:2px;
  overflow:hidden;
}
.info-map iframe{
  width:100%;
  height:100%;
  display:block;
  filter:grayscale(0.3) contrast(1.1) sepia(0.1);
}

@media (max-width:860px){
  .info-grid{grid-template-columns:1fr;gap:40px}
}
</style>
