---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Concept from '../components/Concept.astro';
import Okonomi from '../components/Okonomi.astro';
import Interior from '../components/Interior.astro';
import DayTimeline from '../components/DayTimeline.astro';
import Info from '../components/Info.astro';
import Reserve from '../components/Reserve.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Header />
  <main id="top">
    <Hero />
    <Concept />
    <Okonomi />
    <Interior />
    <DayTimeline />
    <Info />
    <Reserve />
  </main>
  <Footer />
</Base>
